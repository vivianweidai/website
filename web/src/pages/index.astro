---
import DefaultLayout from '../layouts/Default.astro';
import PageHeader from '../layouts/PageHeader.astro';
import PageFooter from '../layouts/PageFooter.astro';
import scienceJpeg from '../layouts/science.jpeg?url';
import curriculumData from '../../public/curriculum/curriculum.json';
import techData from '../../public/projects/technology.json';

// Top → bottom matches the science pyramid: astronomy at the apex,
// mathematics as the foundation. Each row builds on the ones below.
const SUBJECTS = ['astronomy', 'biology', 'chemistry', 'physics', 'computing', 'mathematics'];
const SUBJ_ANCHOR = {
  mathematics: 'math', computing: 'comp', physics: 'phys',
  chemistry: 'chem', biology: 'bio', astronomy: 'astro',
};
// The competitions Vivian sits in each science — the Olympiads tab is a list,
// same shape as the Curriculum tab's section list. Names are the *competition*,
// not the individual sitting: the yearly rounds, levels and camps of one
// olympiad (COMC, the CAAO junior/senior exams + camps, …) collapse to a single
// entry. Spelled out in full — abbreviated only where the full name would push
// the row onto a second line (CAP; JSOC on Chemistry and Physics). The
// /olympiads/ timeline carries the dates.
//
// JSOC repeats on three rows, so it is spelled out on the FIRST one a reader
// meets going top-to-bottom (Biology, which also has the most slack) and left
// short on Chemistry and Physics, where the full name wraps. Same trick on
// Computing: "North American" contracts to "NA" so NACLO can be spelled out at
// all — the full form overruns the row by ~120px. Both expansions leave little
// slack, so re-render the row before lengthening any name on them.
//
// Order within a science is fixed: Canadian first, US second, then whatever is
// neither (JSOC — the cross-science camp). One line per science is the target.
//
// Names only — no achievement icons. Per-competition standing glyphs (⭐/🎯/🇨🇦)
// used to hang off each name here; they were dropped 2026-07-30 because they
// collided visually with the "·" separators and made the row busy. The
// /olympiads/ timeline is where standings live.
const OLYMPIADS = {
  mathematics: [
    'Canadian Open Mathematics Challenge',
    'American Mathematics Competition 12',
  ],
  computing: [
    'Canadian Computing Competition',
    'USA Computing Olympiad',
    'NA Computational Linguistics Open Exam',
  ],
  physics: [
    'CAP High School Prize Exam',
    'USA Physics Olympiad F=ma Exam',
    'JSOC',
  ],
  chemistry: [
    'Canadian Chemistry Olympiad',
    'United States National Chemistry Olympiad',
    'JSOC',
  ],
  biology: [
    'Canadian Biology Olympiad',
    'USA Biology Olympiad',
    'Junior Science Olympiad of Canada',
  ],
  astronomy: [
    'Canadian Astronomy and Astrophysics Olympiad',
    'USA Astronomy and Astrophysics Olympiad',
  ],
};
// The Projects tab lists each science's CATEGORIES — Mechanics, Genomics,
// Measurements — not the individual instruments under them. Eleven toys on the
// Physics row read as clutter where four categories read as a menu, and the
// /projects/ wall uses the same three-tier vocabulary: science, then category,
// then (once a category is open) the toys inside it. A link here lands on the
// wall with that category already selected, which shows every toy in it.
//
// Categories come from technology.json, built by build_technology.py from each
// tech page's frontmatter.
const catSlug = (s) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const CATEGORIES_BY_SCIENCE = {};
for (const s of techData.sciences) {
  CATEGORIES_BY_SCIENCE[s.science.toLowerCase()] = s.techs.map((t) => ({
    label: t.tech,
    slug: catSlug(t.tech),
    // Hover shows what is actually in the category, so the consolidation
    // hides the instrument names without losing them.
    toys: (t.toys ?? []).map((x) => x.short ?? x.name).join(' · '),
  }));
}
const TABS = [
  { key: 'curriculum', label: 'Curriculum' },
  { key: 'olympiads',  label: 'Olympiads'  },
  { key: 'projects',   label: 'Projects'   },
];
---
<DefaultLayout title="Science">
  <PageHeader active="home" />

  <div class="hero-pool fade-in">
    <img class="hero-img" src={scienceJpeg} alt="Science" width="100%" />
    <canvas class="hero-canvas"></canvas>
  </div>

  <div class="curr-rows" data-active="curriculum">
    <div class="curr-rows-tabs">
      <div class="curr-rows-tabs-inner">
        {TABS.map(t => (
          <button class="curr-rows-tab" data-target={t.key} type="button">{t.label}</button>
        ))}
      </div>
    </div>
    <div class="curr-rows-body">
    {SUBJECTS.map((subjSlug, i) => {
      const subj = curriculumData[subjSlug];
      const oly = OLYMPIADS[subjSlug];
      return (
        <div class="curr-rows-row fade-in" style={`animation-delay: ${0.1 + i * 0.08}s`}>
          <a class="curr-rows-subj" data-subj={subjSlug} data-tab="curriculum" href={`/curriculum/#${subjSlug}`}>{subj.name}</a>
          <a class="curr-rows-subj" data-subj={subjSlug} data-tab="olympiads"  href={`/olympiads/#${SUBJ_ANCHOR[subjSlug]}`}>{subj.name}</a>
          <a class="curr-rows-subj" data-subj={subjSlug} data-tab="projects"   href={`/projects/#${SUBJ_ANCHOR[subjSlug]}`}>{subj.name}</a>

          <div class="curr-rows-secs" data-tab="curriculum">
            {subj.sections.map((sec, j) => (
              <>
                {j > 0 && <span class="sep">·</span>}
                <a href={`/curriculum/#${subjSlug}/${sec.slug}`}>{sec.name}</a>
              </>
            ))}
          </div>
          <div class="curr-rows-secs" data-tab="olympiads">
            {oly.map((name, j) => (
              <>
                {j > 0 && <span class="sep">·</span>}
                <a href={`/olympiads/#${SUBJ_ANCHOR[subjSlug]}`}>{name}</a>
              </>
            ))}
          </div>
          <div class="curr-rows-secs" data-tab="projects">
            {CATEGORIES_BY_SCIENCE[subjSlug].map((cat, j) => (
              <>
                {j > 0 && <span class="sep">·</span>}
                <a title={cat.toys}
                   href={`/projects/#${SUBJ_ANCHOR[subjSlug]}/${cat.slug}`}>{cat.label}</a>
              </>
            ))}
          </div>

          <a class="curr-rows-pdf" data-tab="curriculum" href={`/curriculum/notes/${subjSlug}.pdf`}>pdf</a>
        </div>
      );
    })}
    </div>
  </div>

  <style>
    .hero-pool {
      position: relative;
      display: block;
      margin-top: 1em;
      border-radius: 8px;
      overflow: hidden;
      transition: transform 0.5s cubic-bezier(.2,.8,.2,1), box-shadow 0.5s ease, filter 0.5s ease;
    }
    .hero-img {
      display: block;
      width: 100%;
    }
    .hero-canvas {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }
    .hero-pool:hover {
      transform: scale(1.01);
      filter: brightness(1.02);
      box-shadow: 0 5px 14px rgba(0,0,0,.06);
    }
    .curr-rows {
      margin: 2em 0;
      transition: transform 0.2s ease-out, filter 0.18s ease;
    }
    @media (hover: hover) {
      .curr-rows:hover {
        transform: translate(-2px, -2px);
        filter: drop-shadow(0 6px 12px rgba(0,0,0,.08));
      }
    }
    .curr-rows-body {
      border: 1px solid #d1d9e0;
      border-radius: 8px;
      overflow: hidden;
    }
    .curr-rows-tabs {
      display: flex;
      justify-content: center;
    }
    .curr-rows-tabs-inner {
      display: flex;
    }
    .curr-rows-tab {
      display: block;
      padding: 0.6em 1.2em;
      background: transparent;
      border: none;
      font-family: inherit;
      font-weight: 600;
      font-size: 0.9em;
      color: #656d76;
      text-align: center;
      cursor: pointer;
      transition: color 0.15s, background 0.15s;
    }
    .curr-rows-tab:hover { color: #1f2328; }
    .curr-rows[data-active="curriculum"] .curr-rows-tab[data-target="curriculum"],
    .curr-rows[data-active="olympiads"]  .curr-rows-tab[data-target="olympiads"],
    .curr-rows[data-active="projects"]   .curr-rows-tab[data-target="projects"] {
      color: #1f2328;
      background: #e8e8e8;
    }

    /* Tab visibility: hide rows-content not matching active tab */
    .curr-rows[data-active="curriculum"] .curr-rows-row [data-tab]:not([data-tab="curriculum"]),
    .curr-rows[data-active="olympiads"]  .curr-rows-row [data-tab]:not([data-tab="olympiads"]),
    .curr-rows[data-active="projects"]   .curr-rows-row [data-tab]:not([data-tab="projects"]) {
      display: none;
    }

    .curr-rows-row {
      display: flex;
      align-items: center;
      border-bottom: 1px solid #eaecef;
      font-size: 0.9em;
      min-height: 3.3em;
      transition: background 0.15s ease;
      position: relative;
    }

    /* Olympiad rows used to fire a yellow sweep across the row plus a flashing
       COMPETITIVE / TEAM CANADA badge on hover. Removed 2026-07-30 — the
       whole-table lift on .curr-rows:hover is the hover treatment now; the
       per-glyph wiggle/sparkle/wave below is what's left of the achievement
       styling. */
    .curr-rows-row:nth-child(odd) { background: #f6f8fa; }
    .curr-rows-row:hover { background: #eef1f4; }
    .curr-rows-row:last-child { border-bottom: none; }
    .curr-rows-subj {
      flex: 0 0 130px;
      align-self: stretch;
      display: flex;
      align-items: center;
      padding: 0.55em 0.9em;
      font-weight: 600;
      color: #1f2328;
      text-decoration: none;
      transition: filter 0.18s ease;
    }
    .curr-rows-subj:hover {
      filter: brightness(0.94) saturate(1.2);
      text-decoration: underline;
    }
    .curr-rows-row:hover .curr-rows-subj {
      filter: brightness(0.94) saturate(1.2);
    }
    .curr-rows-subj[data-subj="mathematics"] { background: var(--subj-math); }
    .curr-rows-subj[data-subj="computing"]   { background: var(--subj-comp); }
    .curr-rows-subj[data-subj="physics"]     { background: var(--subj-phys); }
    .curr-rows-subj[data-subj="chemistry"]   { background: var(--subj-chem); }
    .curr-rows-subj[data-subj="biology"]     { background: var(--subj-bio); }
    .curr-rows-subj[data-subj="astronomy"]   { background: var(--subj-astro); }
    .curr-rows-secs {
      flex: 1;
      padding: 0.55em 1em;
    }
    .curr-rows-secs a {
      color: #1f2328;
      text-decoration: none;
      padding: 0 0.18em;
    }
    .curr-rows-secs a:hover { color: #0969da; text-decoration: underline; }
    .curr-rows-secs .sep { color: #b1b7be; padding: 0 0.15em; }
    /* The Projects tab's toys carry no styling of their own — they are the
       same dot-separated links as Curriculum's sections and Olympiads'
       competitions, and the three tabs should read as one row that changes
       its contents rather than three different components. Each toy links to
       the /projects/ wall pre-filtered to it. */
    .curr-rows-secs .mi-icon {
      margin-left: 0.35em;
      display: inline-flex;
      align-items: center;
      vertical-align: middle;
      cursor: default;
    }
    .curr-rows-secs .mi-icon img { height: 0.95em; }
    .curr-rows-secs .mi-icon:hover { text-decoration: none; }
    /* Same white bordered pill as the research tab's project badge
       (.home-proj-badge). */
    .curr-rows-pdf {
      flex: 0 0 auto;
      margin-right: 0.9em;
      display: inline-flex;
      align-items: center;
      padding: 0.12em 0.55em;
      border: 1px solid #d8dee4;
      border-radius: 6px;
      background: #fff;
      color: #475059;
      font-size: 0.8em;
      text-decoration: none;
      white-space: nowrap;
      transition: border-color 0.15s ease, color 0.15s ease;
    }
    .curr-rows-pdf:hover {
      border-color: #0969da;
      color: #0969da;
      text-decoration: none;
    }

    .curr-rows-topics {
      flex: 0 0 auto;
      margin-right: 0.9em;
      white-space: nowrap;
    }
    /* Project-count badge — mirrors the research page's .proj-badge: a white
       bordered count pill. Links to the science's filtered research view. */
    .home-proj-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.32em;
      font-size: 0.8em;
      color: #475059;
      text-decoration: none;
      padding: 0.12em 0.55em;
      border: 1px solid #d8dee4;
      border-radius: 6px;
      background: #fff;
      transition: border-color 0.15s ease, color 0.15s ease;
    }
    .home-proj-badge b { font-weight: 700; }
    .home-proj-badge:hover { border-color: #0969da; color: #0969da; }

    /* The Olympiads tab carries NO styling of its own — competition names are
       the same dot-separated links as Curriculum's sections, inheriting the
       same font, size, weight and line-height, so the three tabs read as one
       row that changes contents. (The achievement glyphs and their looser
       line-height were dropped 2026-07-30; see the OLYMPIADS comment above.) */
    @media (max-width: 600px) {
      .curr-rows-row {
        flex-direction: column;
        align-items: stretch;
        min-height: 0;
      }
      .curr-rows-subj { flex: none; text-align: center; }
      .curr-rows-pdf,
      .curr-rows-topics,
      .curr-rows-secs[data-tab="curriculum"] { display: none; }
      .curr-rows-secs { padding: 0.65em 1em; }
    }
    .footer-store-links { display: flex; gap: 0.5em; }
  </style>

  <script is:inline>
    // Hero pool: click ripples in the six subject colors.
    (function () {
      var pool = document.querySelector('.hero-pool');
      if (!pool) return;
      var canvas = pool.querySelector('.hero-canvas');
      var ctx = canvas.getContext('2d');
      var COLORS = ['#c5d9f7', '#d9ccee', '#f9c4a8', '#d4e8a0', '#a8ddd4', '#f4c2cb'];
      var ripples = [];
      var dpr = Math.max(1, window.devicePixelRatio || 1);

      function resize() {
        var rect = pool.getBoundingClientRect();
        if (rect.width === 0 || rect.height === 0) return; // hero img not loaded yet
        canvas.width = Math.round(rect.width * dpr);
        canvas.height = Math.round(rect.height * dpr);
        canvas.style.width = rect.width + 'px';
        canvas.style.height = rect.height + 'px';
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
      resize();
      window.addEventListener('resize', resize);
      // Image may load after the script runs; resize once it has real dimensions.
      var heroImg = pool.querySelector('img');
      if (heroImg && !heroImg.complete) heroImg.addEventListener('load', resize);
      if (typeof ResizeObserver !== 'undefined') new ResizeObserver(resize).observe(pool);

      pool.addEventListener('click', function (e) {
        var rect = pool.getBoundingClientRect();
        var x = e.clientX - rect.left;
        var y = e.clientY - rect.top;
        var color = COLORS[Math.floor(Math.random() * COLORS.length)];
        var minSide = Math.min(rect.width, rect.height);
        // Click ripple — random ellipse, smaller max diameter than before.
        // Stroke is thick at spawn and thins as the ellipse expands (renderer
        // ties lineWidth to remaining progress (1 - t)^2).
        ripples.push({
          x: x, y: y,
          t: 0,
          growT: 0.012 + Math.random() * 0.008,
          rxMax: minSide * (0.14 + Math.random() * 0.10),
          ryMax: minSide * (0.12 + Math.random() * 0.10),
          rotation: Math.random() * Math.PI * 2,
          color: color,
          lw: 20 + Math.random() * 10
        });
        // Smaller echo ring for the water-drop feel.
        setTimeout(function () {
          ripples.push({
            x: x, y: y,
            t: 0,
            growT: 0.013 + Math.random() * 0.007,
            rxMax: minSide * (0.08 + Math.random() * 0.08),
            ryMax: minSide * (0.07 + Math.random() * 0.08),
            rotation: Math.random() * Math.PI * 2,
            color: color,
            lw: 13 + Math.random() * 6
          });
        }, 110 + Math.random() * 110);
      });

      function tick() {
        var rect = pool.getBoundingClientRect();
        ctx.clearRect(0, 0, rect.width, rect.height);

        for (var j = ripples.length - 1; j >= 0; j--) {
          var rp = ripples[j];
          rp.t += rp.growT;
          if (rp.t >= 1) { ripples.splice(j, 1); continue; }
          var remaining = 1 - rp.t;
          ctx.globalAlpha = remaining * 0.9;
          ctx.strokeStyle = rp.color;
          var tt = rp.t * rp.t;
          ctx.lineWidth = rp.lw * (1 - tt * tt * tt); // (1 - t^6) — holds full thickness almost to the end, then drops sharply
          ctx.beginPath();
          ctx.ellipse(rp.x, rp.y, rp.rxMax * rp.t, rp.ryMax * rp.t, rp.rotation, 0, Math.PI * 2);
          ctx.stroke();
        }
        ctx.globalAlpha = 1;

        requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    })();

    // Tabs are click-only: the table opens on Curriculum and stays put until
    // you pick another. (It used to auto-rotate every 5s behind a progress
    // wave; removed 2026-07-30 — a static page reads cleaner.)
    (function () {
      var container = document.querySelector('.curr-rows[data-active]');
      if (!container) return;
      container.querySelectorAll('.curr-rows-tab').forEach(function (btn) {
        btn.addEventListener('click', function () {
          container.dataset.active = btn.dataset.target;
        });
      });
    })();
  </script>

  <hr />

  <PageFooter active="home">
    <div slot="lead" class="footer-store-links">
      <a href="https://apps.apple.com/app/id6762091743">Apple</a>
    </div>
  </PageFooter>
</DefaultLayout>
