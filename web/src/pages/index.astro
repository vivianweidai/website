---
import DefaultLayout from '../layouts/Default.astro';
import PageHeader from '../layouts/PageHeader.astro';
import PageFooter from '../layouts/PageFooter.astro';
import scienceJpeg from '../layouts/science.jpeg?url';
import curriculumData from '../../public/curriculum/curriculum.json';
import techData from '../../public/projects/technology.json';

// Top → bottom matches the science pyramid: astronomy at the apex,
// mathematics as the foundation. Each row builds on the ones below.
const SUBJECTS = ['astronomy', 'biology', 'chemistry', 'physics', 'computing', 'mathematics'];
const SUBJ_ANCHOR = {
  mathematics: 'math', computing: 'comp', physics: 'phys',
  chemistry: 'chem', biology: 'bio', astronomy: 'astro',
};
// The competitions Vivian sits in each science — the Olympiads tab is a list,
// same shape as the Curriculum tab's section list. One entry per *competition*,
// not per sitting: the yearly rounds, levels and camps of one olympiad collapse
// to a single row.
//
// Acronyms, not full names (2026-07-30). Spelled out, three competitions per
// science ran to two lines on a laptop and wrapped badly on a phone; the full
// name rides along as the link's title so hovering still explains it, and the
// /olympiads/ timeline carries the long form and the dates.
//
// Order within a science is fixed: Canadian first, US second, then whatever is
// neither (JSOC, the cross-science camp).
const OLYMPIADS = {
  mathematics: [
    ['COMC',   'Canadian Open Mathematics Challenge'],
    ['AMC',    'American Mathematics Competition'],
  ],
  computing: [
    ['CCC',    'Canadian Computing Competition'],
    ['USACO',  'USA Computing Olympiad'],
    ['NACLO',  'North American Computational Linguistics Open'],
  ],
  physics: [
    ['CAP',    'Canadian Association of Physicists High School Prize Exam'],
    ['F=ma',   'USA Physics Olympiad F=ma Exam'],
    ['JSOC',   'Junior Science Olympiad of Canada'],
  ],
  chemistry: [
    ['CCO',    'Canadian Chemistry Olympiad'],
    ['USNCO',  'United States National Chemistry Olympiad'],
    ['JSOC',   'Junior Science Olympiad of Canada'],
  ],
  biology: [
    ['CBO',    'Canadian Biology Olympiad'],
    ['USABO',  'USA Biology Olympiad'],
    ['JSOC',   'Junior Science Olympiad of Canada'],
  ],
  astronomy: [
    ['CAAO',   'Canadian Astronomy and Astrophysics Olympiad'],
    ['USAAAO', 'USA Astronomy and Astrophysics Olympiad'],
  ],
};
// The Projects tab lists each science's CATEGORIES — Mechanics, Genomics,
// Measurements — not the individual instruments under them. Eleven toys on the
// Physics row read as clutter where four categories read as a menu, and the
// /projects/ wall uses the same three-tier vocabulary: science, then category,
// then (once a category is open) the toys inside it. A link here lands on the
// wall with that category already selected, which shows every toy in it.
//
// Categories come from technology.json, built by build_technology.py from each
// tech page's frontmatter.
const catSlug = (s) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const CATEGORIES_BY_SCIENCE = {};
for (const s of techData.sciences) {
  CATEGORIES_BY_SCIENCE[s.science.toLowerCase()] = s.techs.map((t) => ({
    label: t.tech,
    slug: catSlug(t.tech),
    // Hover shows what is actually in the category, so the consolidation
    // hides the instrument names without losing them.
    toys: (t.toys ?? []).map((x) => x.short ?? x.name).join(' · '),
  }));
}
const TABS = [
  { key: 'curriculum', label: 'Curriculum' },
  { key: 'olympiads',  label: 'Olympiads'  },
  { key: 'projects',   label: 'Projects'   },
];
---
<DefaultLayout title="Science">
  <PageHeader active="home" />

  <div class="hero-pool fade-in">
    <img class="hero-img" src={scienceJpeg} alt="Science" width="100%" />
  </div>

  <div class="curr-rows" data-active="curriculum">
    <div class="curr-rows-tabs">
      <div class="curr-rows-tabs-inner">
        {TABS.map(t => (
          <button class="curr-rows-tab" data-target={t.key} type="button">{t.label}</button>
        ))}
      </div>
    </div>
    <div class="curr-rows-body">
    {SUBJECTS.map((subjSlug, i) => {
      const subj = curriculumData[subjSlug];
      const oly = OLYMPIADS[subjSlug];
      return (
        <div class="curr-rows-row fade-in" style={`animation-delay: ${0.1 + i * 0.08}s`}>
          <a class="curr-rows-subj" data-subj={subjSlug} data-tab="curriculum" href={`/curriculum/#${subjSlug}`}>{subj.name}</a>
          <a class="curr-rows-subj" data-subj={subjSlug} data-tab="olympiads"  href={`/olympiads/#${SUBJ_ANCHOR[subjSlug]}`}>{subj.name}</a>
          <a class="curr-rows-subj" data-subj={subjSlug} data-tab="projects"   href={`/projects/#${SUBJ_ANCHOR[subjSlug]}`}>{subj.name}</a>

          <div class="curr-rows-secs" data-tab="curriculum">
            {subj.sections.map((sec, j) => (
              <>
                {j > 0 && <span class="sep">·</span>}
                <a href={`/curriculum/#${subjSlug}/${sec.slug}`}>{sec.name}</a>
              </>
            ))}
          </div>
          <div class="curr-rows-secs" data-tab="olympiads">
            {oly.map(([abbr, full], j) => (
              <>
                {j > 0 && <span class="sep">·</span>}
                <a title={full} href={`/olympiads/#${SUBJ_ANCHOR[subjSlug]}`}>{abbr}</a>
              </>
            ))}
          </div>
          <div class="curr-rows-secs" data-tab="projects">
            {CATEGORIES_BY_SCIENCE[subjSlug].map((cat, j) => (
              <>
                {j > 0 && <span class="sep">·</span>}
                <a title={cat.toys}
                   href={`/projects/#${SUBJ_ANCHOR[subjSlug]}`}>{cat.label}</a>
              </>
            ))}
          </div>
        </div>
      );
    })}
    </div>
  </div>

  <style>
    /* Hover lift only — the click ripples and the cursor trail that used to
       live on a canvas over this image are gone. */
    .hero-pool {
      position: relative;
      display: block;
      margin-top: 1em;
      border-radius: 8px;
      overflow: hidden;
      transition: transform 0.5s cubic-bezier(.2,.8,.2,1), box-shadow 0.5s ease, filter 0.5s ease;
    }
    .hero-img {
      display: block;
      width: 100%;
    }
    .hero-pool:hover {
      transform: scale(1.01);
      filter: brightness(1.02);
      box-shadow: 0 5px 14px rgba(0,0,0,.06);
    }
    .curr-rows {
      margin: 2em 0;
      transition: transform 0.2s ease-out, filter 0.18s ease;
    }
    @media (hover: hover) {
      .curr-rows:hover {
        transform: translate(-2px, -2px);
        filter: drop-shadow(0 6px 12px rgba(0,0,0,.08));
      }
    }
    .curr-rows-body {
      border: 1px solid #d1d9e0;
      border-radius: 8px;
      overflow: hidden;
    }
    .curr-rows-tabs {
      display: flex;
      justify-content: center;
    }
    .curr-rows-tabs-inner {
      display: flex;
    }
    .curr-rows-tab {
      display: block;
      padding: 0.6em 1.2em;
      background: transparent;
      border: none;
      font-family: inherit;
      font-weight: 600;
      font-size: 0.9em;
      color: #656d76;
      text-align: center;
      cursor: pointer;
      transition: color 0.15s, background 0.15s;
    }
    .curr-rows-tab:hover { color: #1f2328; }
    .curr-rows[data-active="curriculum"] .curr-rows-tab[data-target="curriculum"],
    .curr-rows[data-active="olympiads"]  .curr-rows-tab[data-target="olympiads"],
    .curr-rows[data-active="projects"]   .curr-rows-tab[data-target="projects"] {
      color: #1f2328;
      background: #e8e8e8;
    }

    /* Tab visibility: hide rows-content not matching active tab */
    .curr-rows[data-active="curriculum"] .curr-rows-row [data-tab]:not([data-tab="curriculum"]),
    .curr-rows[data-active="olympiads"]  .curr-rows-row [data-tab]:not([data-tab="olympiads"]),
    .curr-rows[data-active="projects"]   .curr-rows-row [data-tab]:not([data-tab="projects"]) {
      display: none;
    }

    .curr-rows-row {
      display: flex;
      align-items: center;
      border-bottom: 1px solid #eaecef;
      font-size: 0.9em;
      min-height: 3.3em;
      transition: background 0.15s ease;
      position: relative;
    }

    /* Olympiad rows used to fire a yellow sweep across the row plus a flashing
       COMPETITIVE / TEAM CANADA badge on hover. Removed 2026-07-30 — the
       whole-table lift on .curr-rows:hover is the hover treatment now; the
       per-glyph wiggle/sparkle/wave below is what's left of the achievement
       styling. */
    .curr-rows-row:nth-child(odd) { background: #f6f8fa; }
    .curr-rows-row:hover { background: #eef1f4; }
    .curr-rows-row:last-child { border-bottom: none; }
    .curr-rows-subj {
      flex: 0 0 130px;
      align-self: stretch;
      display: flex;
      align-items: center;
      padding: 0.55em 0.9em;
      font-weight: 600;
      color: #1f2328;
      text-decoration: none;
      transition: filter 0.18s ease;
    }
    .curr-rows-subj:hover {
      filter: brightness(0.94) saturate(1.2);
      text-decoration: underline;
    }
    .curr-rows-row:hover .curr-rows-subj {
      filter: brightness(0.94) saturate(1.2);
    }
    .curr-rows-subj[data-subj="mathematics"] { background: var(--subj-math); }
    .curr-rows-subj[data-subj="computing"]   { background: var(--subj-comp); }
    .curr-rows-subj[data-subj="physics"]     { background: var(--subj-phys); }
    .curr-rows-subj[data-subj="chemistry"]   { background: var(--subj-chem); }
    .curr-rows-subj[data-subj="biology"]     { background: var(--subj-bio); }
    .curr-rows-subj[data-subj="astronomy"]   { background: var(--subj-astro); }
    .curr-rows-secs {
      flex: 1;
      padding: 0.55em 1em;
    }
    .curr-rows-secs a {
      color: #1f2328;
      text-decoration: none;
      padding: 0 0.18em;
    }
    .curr-rows-secs a:hover { color: #0969da; text-decoration: underline; }
    .curr-rows-secs .sep { color: #b1b7be; padding: 0 0.15em; }
    /* The Projects tab's toys carry no styling of their own — they are the
       same dot-separated links as Curriculum's sections and Olympiads'
       competitions, and the three tabs should read as one row that changes
       its contents rather than three different components. Each toy links to
       the /projects/ wall pre-filtered to it. */

    /* The Olympiads tab carries NO styling of its own — competition names are
       the same dot-separated links as Curriculum's sections, inheriting the
       same font, size, weight and line-height, so the three tabs read as one
       row that changes contents. (The achievement glyphs and their looser
       line-height were dropped 2026-07-30; see the OLYMPIADS comment above.) */
    @media (max-width: 600px) {
      .curr-rows-row {
        flex-direction: column;
        align-items: stretch;
        min-height: 0;
      }
      .curr-rows-subj { flex: none; text-align: center; }
      /* The Curriculum sections used to be hidden here, which left the tab
         as six coloured bars and no content on a phone. The row is a column
         at this width, so the list has somewhere to go. */
      .curr-rows-secs { padding: 0.65em 1em; }
    }
    .footer-store-links { display: flex; gap: 0.5em; }
  </style>

  <script is:inline>


    // Tabs are click-only: the table opens on Curriculum and stays put until
    // you pick another. (It used to auto-rotate every 5s behind a progress
    // wave; removed 2026-07-30 — a static page reads cleaner.)
    (function () {
      var container = document.querySelector('.curr-rows[data-active]');
      if (!container) return;
      container.querySelectorAll('.curr-rows-tab').forEach(function (btn) {
        btn.addEventListener('click', function () {
          container.dataset.active = btn.dataset.target;
        });
      });
    })();
  </script>

  <hr />

  <PageFooter active="home">
    <div slot="lead" class="footer-store-links">
      <a href="https://apps.apple.com/app/id6762091743">Apple</a>
    </div>
  </PageFooter>
</DefaultLayout>
