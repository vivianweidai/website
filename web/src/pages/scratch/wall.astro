const toys = [...new Set(WALL.map((x) => x.toy))];
---
<DefaultLayout title="Projects — The Wall">
  <PageHeader active="research" title="Projects" />
  <OptionBar active="wall" />

  <div class="wall-bar" id="wall-bar">
    <div class="wb-group">
      <button class="wp on" data-k="sci" data-v="all">Everything</button>
      {(['phys','chem','bio','astro'] as const).map((s) => (
        <button class="wp" data-k="sci" data-v={s} style={`--f: ${SCI[s].tint}`}>{SCI[s].name}</button>
      ))}
    </div>
    <div class="wb-group toys">
      {toys.map((t) => <button class="wp small" data-k="toy" data-v={t}>{t}</button>)}
    </div>
  </div>

  <div class="wall" id="wall">
    {WALL.map((x) => (
      <figure class="wt" data-sci={x.sci} data-toy={x.toy} style={`--tint: ${SCI[x.sci].tint}`}>
        <img src={x.src} alt={x.cap} loading="lazy" />
        <figcaption>
          <b>{x.cap}</b>
          <span>{x.toy} · {x.date}</span>
        </figcaption>
      </figure>
    ))}
  </div>

  <p class="wall-foot">
    <a href="#">What we own</a> — {BENCH.length} on the bench, {DESK.length} at the desk.
    <span> Every picture above came off one of them.</span>
  </p>

  <script is:inline>
    (function () {
      var state = { sci: 'all', toy: null };
      var bar = document.getElementById('wall-bar');
      bar.addEventListener('click', function (e) {
        var b = e.target.closest('.wp'); if (!b) return;
        var k = b.dataset.k, v = b.dataset.v;
        if (k === 'sci') { state.sci = v; state.toy = null; }
        else { state.toy = state.toy === v ? null : v; }
        bar.querySelectorAll('.wp[data-k="sci"]').forEach(function (x) {
          x.classList.toggle('on', x.dataset.v === state.sci);
        });
        bar.querySelectorAll('.wp[data-k="toy"]').forEach(function (x) {
          x.classList.toggle('on', x.dataset.v === state.toy);
        });
        document.querySelectorAll('.wt').forEach(function (t) {
          var ok = (state.sci === 'all' || t.dataset.sci === state.sci)
                && (!state.toy || t.dataset.toy === state.toy);
          t.style.display = ok ? '' : 'none';
        });
      });
    })();
  </script>

  <style is:global>
    .wall-bar { margin-bottom: 1.2em; }
    .wb-group { display: flex; flex-wrap: wrap; gap: .35em; }
    .wb-group.toys { margin-top: .5em; padding-top: .5em; border-top: 1px dashed #e2e6ea; }
    .wp {
      font: inherit; font-size: .82em; font-weight: 600; cursor: pointer;
      padding: .25em .75em; border-radius: 999px;
      border: 1px solid #d8dee4; background: #fff; color: #475059;
      transition: background .15s, color .15s, border-color .15s;
    }
    .wp.small { font-size: .74em; font-weight: 500; padding: .15em .6em; color: #8b949e; }
    .wp:hover { background: var(--f, #f1f3f5); border-color: #b6c0ca; }
    .wp.on { background: var(--f, #1f2328); border-color: transparent; color: #1f2328; }
    .wp[data-v="all"].on, .wp.small.on { background: #1f2328; color: #fff; }

    .wall { columns: 4 190px; column-gap: 10px; }
    .wt {
      margin: 0 0 10px; break-inside: avoid; position: relative;
      border-radius: 8px; overflow: hidden; background: #0b0d10;
      box-shadow: 0 1px 3px rgba(0,0,0,.1);
    }
    .wt img { width: 100%; display: block; }
    .wt figcaption {
      position: absolute; inset: auto 0 0 0; padding: 2em .6em .5em;
      background: linear-gradient(to top, rgba(0,0,0,.88), rgba(0,0,0,.35) 55%, transparent);
      color: #fff; opacity: 0; transition: opacity .2s ease;
    }
    .wt:hover figcaption { opacity: 1; }
    .wt figcaption b { display: block; font-size: .78em; line-height: 1.3; }
    .wt figcaption span { display: block; font-size: .68em; color: #b9c1c9; margin-top: .15em; }
    .wt::after {
      content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
      background: var(--tint); opacity: .9;
    }
    .wall-foot { margin-top: 1.6em; font-size: .85em; color: #656d76; }
    .wall-foot span { color: #b0b8c0; }
    @media (max-width: 600px) {
      .wall { columns: 2 130px; }
      .wt figcaption { opacity: 1; }
    }
  </style>

  <hr />
  <PageFooter active="research" />
</DefaultLayout>
