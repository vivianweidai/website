---
import DefaultLayout from '../../layouts/Default.astro';
import PageHeader from '../../layouts/PageHeader.astro';
import PageFooter from '../../layouts/PageFooter.astro';
import OptionBar from './_OptionBar.astro';
import { P, SCI, BENCH, DESK, type Sci } from './_data';

interface W { src: string; cap: string; toy: string; sci: Sci; date: string }
const w = (proj: string, rest: string, cap: string, toy: string, sci: Sci, date: string): W =>
  ({ src: P(proj, rest), cap, toy, sci, date });

const SG = '20260725 Stargazing', CG = '20260725 Cellgazing';
const UV = '20260420 UV-Vis Spectroscopy', IRP = '20260419 IR Spectroscopy';
const CE = '20260411 Centrifuge', MP = '20260405 Melting Point';
const FP = '20260404 Four Point Probe', CF = '20250225 Catfood';

const WALL: W[] = [
  w(SG, 'data/M_31__Stacked_25_M_31_20.0s_IRCUT_20260730-015655.jpg', 'M 31 · 25 × 20s', 'Seestar', 'astro', 'Jul 30'),
  w(SG, 'data/NGC_7000__Stacked_20_NGC_7000_20.0s_IRCUT_20260730-014616.jpg', 'NGC 7000 · 20 × 20s', 'Seestar', 'astro', 'Jul 30'),
  w(CG, 'data/tissue-section.jpg', 'Tissue section, 400×', 'Compound', 'bio', 'Jul 25'),
  w(UV, 'photos/samples/samples3.jpeg', 'The amber bottle shelf', 'UV-Vis', 'chem', 'Apr 20'),
  w(SG, 'data/Albireo__Light_Albireo_20.0s_IRCUT_failed_20260729-225851.jpg', 'Albireo — a field of spectra, by accident', 'Seestar', 'astro', 'Jul 29'),
  w(CE, 'photos/samples/samples1.jpeg', 'Red caps, ready to spin', 'PCR', 'bio', 'Apr 11'),
  w(FP, 'photos/samples/samples3.jpeg', 'Gold on glass', 'Oscilloscope', 'phys', 'Apr 4'),
  w(CG, 'data/leaf-epidermis.jpg', 'Leaf epidermis — stomata everywhere', 'Stereo', 'bio', 'Jul 25'),
  w(SG, 'data/M_13__Stacked_5_M_13_60.0s_IRCUT_20260728-225801.jpg', 'M 13 · 5 × 60s', 'Seestar', 'astro', 'Jul 28'),
  w(MP, 'photos/setup/setup3.jpeg', 'Watching the capillary go clear', 'Temperature', 'chem', 'Apr 5'),
  w(CF, 'photos/setup/setup1.jpeg', 'The subject declines to participate', 'SciPy', 'bio', 'Feb 25'),
  w(UV, 'photos/samples/samples6.jpeg', 'Quinine under the lamp', 'UV-Vis', 'chem', 'Apr 20'),
  w(SG, 'data/Vega__Light_Vega_5.0s_IRCUT_failed_20260729-222828.jpg', 'Vega — grating on backwards', 'Seestar', 'astro', 'Jul 29'),
  w(CE, 'photos/samples/samples9.jpeg', 'Rack of everything', 'Electrophoresis', 'bio', 'Apr 11'),
  w(IRP, 'photos/setup/setup3.jpeg', 'Plate down, lid closed', 'UV-Vis', 'chem', 'Apr 19'),
  w(CG, 'data/reticulate-specimen.jpg', 'Reticulate specimen, handheld', 'Surface', 'bio', 'Jul 25'),
  w(SG, 'data/Juno__Light_Juno_20.0s_IRCUT_20260729-000521.jpg', 'Juno — before', 'Seestar', 'astro', 'Jul 29'),
  w(SG, 'data/Juno__Light_Juno_20.0s_IRCUT_20260729-003012.jpg', 'Juno — after', 'Seestar', 'astro', 'Jul 29'),
  w(UV, 'photos/samples/samples5.jpeg', 'Cuvettes loaded', 'UV-Vis', 'chem', 'Apr 20'),
  w(FP, 'photos/samples/samples1.jpeg', 'Coupons cut and laid out', 'Oscilloscope', 'phys', 'Apr 4'),
  w(SG, 'data/Delta_Cygni__Stacked_54_Delta_Cygni_5.0s_IRCUT_20260728-223243.jpg', 'Delta Cygni · 54 × 5s', 'Seestar', 'astro', 'Jul 28'),
  w(CE, 'photos/samples/samples7.jpeg', 'Blue caps this time', 'PCR', 'bio', 'Apr 11'),
  w(UV, 'photos/samples/samples4.jpeg', 'Everything coloured we could find', 'UV-Vis', 'chem', 'Apr 20'),
  w(CF, 'output/catfood_preference.png', 'She has a preference. p = 0.03', 'SciPy', 'comp', 'Feb 25'),
  w(SG, 'data/M_51__Stacked_30_M_51_10.0s_IRCUT_20260704-222846.jpg', 'M 51 · 30 × 10s', 'Seestar', 'astro', 'Jul 4'),
  w(UV, 'output/images/uvvis_overlay.png', 'All four traces on one axis', 'Matplotlib', 'chem', 'Apr 20'),
  w(IRP, 'photos/setup/setup11.jpeg', 'Beam path, lid up', 'UV-Vis', 'chem', 'Apr 19'),
  w(SG, 'data/Vega__Stacked_8_Vega_10.0s_IRCUT_20260725-011926.jpg', 'Vega · 8 × 10s', 'Seestar', 'astro', 'Jul 25'),
  w(FP, 'photos/setup/setup13.jpeg', 'Four probes down', 'Oscilloscope', 'phys', 'Apr 4'),
  w(CE, 'photos/setup/setup3.jpeg', 'Weighing it out', 'PCR', 'bio', 'Apr 11'),
  w(CF, 'photos/setup/setup5.jpeg', 'Two bowls, blind trial', 'SciPy', 'bio', 'Feb 25'),
  w(SG, 'data/RR_Lyrae__Stacked_21_RR_Lyrae_5.0s_IRCUT_20260725-020642.jpg', 'RR Lyrae · 21 × 5s', 'Seestar', 'astro', 'Jul 25'),
  w(UV, 'photos/samples/samples7.jpeg', 'Left to settle', 'UV-Vis', 'chem', 'Apr 20'),
  w(CE, 'photos/setup/setup1.jpeg', 'Cycler warming up', 'PCR', 'bio', 'Apr 11'),
  w(SG, 'data/Deneb__Stacked_32_Deneb_10.0s_IRCUT_20260725-015351.jpg', 'Deneb · 32 × 10s', 'Seestar', 'astro', 'Jul 25'),
  w(FP, 'output/mean_sheet_resistance.png', 'Sheet resistance, finally', 'Matplotlib', 'phys', 'Apr 4'),
  w(CE, 'photos/samples/samples12.jpeg', 'Caps colour-coded by condition', 'Electrophoresis', 'bio', 'Apr 11'),
  w(SG, 'data/NGC_5907__Stacked_9_NGC_5907_10.0s_IRCUT_20260704-223446.jpg', 'NGC 5907 · 9 × 10s', 'Seestar', 'astro', 'Jul 4'),
  w(CF, 'photos/setup/setup9.jpeg', 'She came back', 'SciPy', 'bio', 'Feb 25'),
  w(MP, 'photos/setup/setup6.jpeg', 'The stage, mid-transition', 'Temperature', 'chem', 'Apr 5'),
  w(SG, 'data/V530_Lyrae__Light_V530_Lyrae_2.0s_IRCUT_20260728-232423.jpg', 'V530 Lyrae · 1 × 2s', 'Seestar', 'astro', 'Jul 28'),
  w(CE, 'photos/setup/setup5.jpeg', 'Rotor balanced', 'PCR', 'bio', 'Apr 11'),
  w(FP, 'photos/samples/samples2.jpeg', 'Printed jig', '3D Printer', 'phys', 'Apr 4'),
  w(UV, 'photos/setup/setup5.jpeg', 'Software fighting us again', 'UV-Vis', 'chem', 'Apr 20'),
  w('20260401 Genes in Space', 'photos/photo.jpeg', 'Our PCR run, on the ISS', 'PCR', 'bio', 'Apr 1'),
  w(SG, 'data/Vega__Light_Vega_10.0s_LP_20260728-233740.jpg', 'Vega spectrum · 1 × 10s', 'Seestar', 'astro', 'Jul 28'),
