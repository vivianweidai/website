---
import DefaultLayout from '../../layouts/Default.astro';
import PageHeader from '../../layouts/PageHeader.astro';
import PageFooter from '../../layouts/PageFooter.astro';
import OptionBar from './_OptionBar.astro';
import { STREAM, BENCH, DESK, SCI, type Sci } from './_data';

const benches: Sci[] = ['phys', 'chem', 'bio', 'astro'];
const shotsFor = (s: Sci) => STREAM.filter((x) => x.sci === s);
const toysFor = (s: Sci) => BENCH.filter((t) => t.sci === s);
const toolchain = DESK.filter((t) => t.sci === 'math' || t.sci === 'comp');
const writeups: Record<Sci, string[]> = {
  phys: ['Four Point Probe'],
  chem: ['UV-Vis Spectroscopy', 'IR Spectroscopy', 'Melting Point'],
  bio: ['Centrifuge', 'Genes in Space', 'Cellgazing'],
  astro: ['Stargazing'],
  math: [], comp: [],
};
---
<DefaultLayout title="Projects — Four Benches">
  <PageHeader active="research" title="Projects" />
  <OptionBar active="benches" />

  <div class="tabs bench-tabs" id="bench-tabs">
    {benches.map((s, i) => (
      <input type="radio" name="bench" id={`b-${s}`} checked={i === 3} />
    ))}
    <div class="tab-labels">
      {benches.map((s) => (
        <label for={`b-${s}`}>
          <span class="label-full">{SCI[s].name}</span><span class="label-abbr">{SCI[s].abbr}</span>
        </label>
      ))}
    </div>
  </div>

  {benches.map((s) => (
    <section class={`bench bench-${s}`} style={`--tint: ${SCI[s].tint}; --ink: ${SCI[s].ink}`}>
      <div class="bench-gal">
        {shotsFor(s).slice(0, 9).map((sh, i) => (
          <figure class={i === 0 ? 'lead' : ''}>
            <img src={sh.src} alt={sh.cap} loading="lazy" />
            <figcaption><b>{sh.cap}</b><span>{sh.date}</span></figcaption>
          </figure>
        ))}
      </div>

      <div class="bench-sub">On the bench <i>{toysFor(s).length}</i></div>
      <div class="bench-toys">
        {toysFor(s).map((t) => (
          <span class="btoy" title={t.name}>
            <b>{t.short}</b><i>{t.note}</i>
          </span>
        ))}
      </div>

      {writeups[s].length > 0 && (
        <>
          <div class="bench-sub">Written up <i>{writeups[s].length}</i></div>
          <div class="bench-wr">
            {writeups[s].map((w) => <a href="#">{w}</a>)}
          </div>
        </>
      )}
    </section>
  ))}

  <div class="toolchain">
    <div class="tc-head">
      <b>The toolchain</b>
      <span>Mathematics and Computing are not benches — they are how we look at what the benches produce.</span>
    </div>
    <div class="tc-items">
      {toolchain.map((t) => (
        <span class="tc-item" style={`--tint: ${SCI[t.sci].tint}`}>{t.short}</span>
      ))}
    </div>
  </div>

  <style is:global>
    .bench-tabs > .tab-labels { border-image: linear-gradient(to right, var(--subj-phys), var(--subj-chem), var(--subj-bio), var(--subj-astro)) 1; }
    #b-phys:checked  ~ .tab-labels label[for="b-phys"]  { color: #ea580c; border-bottom-color: #ea580c; background: var(--subj-phys); }
    #b-chem:checked  ~ .tab-labels label[for="b-chem"]  { color: #5c7a10; border-bottom-color: #5c7a10; background: var(--subj-chem); }
    #b-bio:checked   ~ .tab-labels label[for="b-bio"]   { color: #0e8577; border-bottom-color: #0e8577; background: var(--subj-bio); }
    #b-astro:checked ~ .tab-labels label[for="b-astro"] { color: #e11d48; border-bottom-color: #e11d48; background: var(--subj-astro); }

    .bench { display: none; padding-top: 1.4em; }
    body:has(#b-phys:checked)  .bench-phys,
    body:has(#b-chem:checked)  .bench-chem,
    body:has(#b-bio:checked)   .bench-bio,
    body:has(#b-astro:checked) .bench-astro { display: block; animation: fadeUp .45s ease backwards; }

    .bench-gal {
      display: grid; gap: 8px; grid-template-columns: repeat(4, 1fr);
      background: #0d1013; padding: 8px; border-radius: 10px;
    }
    .bench-gal figure { margin: 0; position: relative; overflow: hidden; border-radius: 6px; }
    .bench-gal figure.lead { grid-column: span 2; grid-row: span 2; }
    .bench-gal img { width: 100%; height: 100%; aspect-ratio: 1; object-fit: cover; display: block; }
    .bench-gal figure.lead img { aspect-ratio: auto; }
    .bench-gal figcaption {
      position: absolute; left: 0; right: 0; bottom: 0;
      padding: 1.6em .55em .4em;
      background: linear-gradient(to top, rgba(0,0,0,.82), transparent);
      color: #fff; font-size: .7em; line-height: 1.3;
      display: flex; justify-content: space-between; align-items: flex-end; gap: .4em;
      opacity: 0; transition: opacity .18s ease;
    }
    .bench-gal figure:hover figcaption { opacity: 1; }
    .bench-gal figcaption span { color: #b9c1c9; flex-shrink: 0; }

    .bench-sub {
      display: flex; align-items: baseline; gap: .5em;
      font-weight: 700; font-size: .95em; margin: 1.8em 0 .6em;
      border-bottom: 1px solid #eaecef; padding-bottom: .25em;
    }
    .bench-sub i { font-style: normal; font-size: .8em; font-weight: 600; color: #8b949e; }

    .bench-toys { display: flex; flex-wrap: wrap; gap: .4em; }
    .btoy {
      display: inline-flex; align-items: baseline; gap: .45em;
      font-size: .82em; padding: .22em .6em; border-radius: 6px;
      background: color-mix(in srgb, var(--tint) 40%, white);
    }
    .btoy b { font-weight: 700; }
    .btoy i { font-style: normal; color: #5b6570; font-size: .88em; }

    .bench-wr { display: flex; flex-wrap: wrap; gap: .5em; }
    .bench-wr a {
      font-size: .82em; padding: .2em .65em; border: 1px solid #d8dee4;
      border-radius: 6px; color: #475059;
    }
    .bench-wr a:hover { border-color: var(--ink); color: var(--ink); text-decoration: none; }

    .toolchain {
      margin-top: 2.6em; padding: .9em 1em;
      background: #f6f8fa; border-radius: 10px; border: 1px solid #eaecef;
    }
    .tc-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: .6em; margin-bottom: .6em; }
    .tc-head b { font-size: .95em; }
    .tc-head span { font-size: .8em; color: #8b949e; }
    .tc-items { display: flex; flex-wrap: wrap; gap: .3em; }
    .tc-item { font-size: .78em; padding: .1em .55em; border-radius: 5px; background: var(--tint); }

    @media (max-width: 640px) {
      .bench-gal { grid-template-columns: repeat(2, 1fr); }
      .bench-gal figcaption { opacity: 1; }
    }
  </style>

  <hr />
  <PageFooter active="research" />
</DefaultLayout>
