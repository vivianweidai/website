---
import DefaultLayout from '../../layouts/Default.astro';
import PageHeader from '../../layouts/PageHeader.astro';
import PageFooter from '../../layouts/PageFooter.astro';
import OptionBar from './_OptionBar.astro';
import { BENCH, DESK, SCI, STATUS, type Status, type Sci } from './_data';

const rungs: Status[] = ['boxed', 'working', 'measured', 'extended'];
const inRung = (r: Status) => BENCH.filter((t) => t.status === r);
---
<DefaultLayout title="Projects — The Ladder">
  <PageHeader active="research" title="Projects" />
  <OptionBar active="ladder" />

  <p class="lad-intro">
    Every toy climbs the same four rungs. Where it sits <em>is</em> the status —
    no write-up needed to say so. Most of the collection is still on the left.
  </p>

  <div class="lad-filter" id="lad-filter">
    <button class="lf2 on" data-f="all">All four sciences</button>
    {(['phys','chem','bio','astro'] as const).map((s) => (
      <button class="lf2" data-f={s} style={`--f: ${SCI[s].tint}`}>{SCI[s].name}</button>
    ))}
  </div>

  <div class="ladder">
    {rungs.map((r, i) => (
      <div class={`rung r${i}`}>
        <div class="rung-head">
          <span class="rung-n">{i + 1}</span>
          <div>
            <b>{STATUS[r].label}</b>
            <i>{STATUS[r].blurb}</i>
          </div>
          <span class="rung-count">{inRung(r).length}</span>
        </div>
        <div class="rung-body">
          {inRung(r).map((t) => (
            <div class="rtoy" data-sci={t.sci} style={`--tint: ${SCI[t.sci].tint}`} title={t.name}>
              {t.img
                ? <img src={t.img} alt="" loading="lazy" />
                : <span class="rtoy-noimg" />}
              <span class="rtoy-txt">
                <b>{t.short}</b>
                <i>{t.note}</i>
              </span>
              {t.shots ? <span class="rtoy-shots">{t.shots}</span> : null}
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>

  <div class="lad-desk">
    <div class="ld-head">
      <b>The desk</b>
      <span>{DESK.length} archives, libraries and languages. They don't climb — they're how we read the rungs.</span>
    </div>
    <div class="ld-items">
      {(['astro','math','comp'] as Sci[]).map((s) => (
        <div class="ld-row">
          <span class="ld-label" style={`--tint: ${SCI[s].tint}`}>{SCI[s].abbr}</span>
          {DESK.filter((t) => t.sci === s).map((t) => <span class="ld-item">{t.short}</span>)}
        </div>
      ))}
    </div>
  </div>

  <script is:inline>
    (function () {
      var bar = document.getElementById('lad-filter');
      bar.addEventListener('click', function (e) {
        var b = e.target.closest('.lf2'); if (!b) return;
        var f = b.dataset.f;
        bar.querySelectorAll('.lf2').forEach(function (x) { x.classList.toggle('on', x === b); });
        document.querySelectorAll('.rtoy').forEach(function (c) {
          c.style.display = (f === 'all' || c.dataset.sci === f) ? '' : 'none';
        });
      });
    })();
  </script>

  <style is:global>
    .lad-intro { font-size: .92em; color: #475059; max-width: 44em; margin: 0 0 1.1em; }
    .lad-filter { display: flex; flex-wrap: wrap; gap: .35em; margin-bottom: 1.4em; }
    .lf2 {
      font: inherit; font-size: .82em; font-weight: 600; cursor: pointer;
      padding: .25em .75em; border-radius: 999px;
      border: 1px solid #d8dee4; background: #fff; color: #475059;
    }
    .lf2:hover { background: var(--f, #f1f3f5); }
    .lf2.on { background: var(--f, #1f2328); border-color: transparent; color: #1f2328; }
    .lf2[data-f="all"].on { background: #1f2328; color: #fff; }

    .ladder { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; align-items: start; }
    .rung { border: 1px solid #e2e6ea; border-radius: 10px; background: #fbfcfd; overflow: hidden; }
    .rung.r0 { background: #fafbfc; }
    .rung.r3 { background: #fff; border-color: #cfd8e0; box-shadow: 0 2px 10px rgba(0,0,0,.05); }

    .rung-head {
      display: flex; align-items: center; gap: .5em;
      padding: .55em .6em; border-bottom: 1px solid #eaecef; background: #fff;
    }
    .rung-n {
      flex: 0 0 auto; width: 1.5em; height: 1.5em; border-radius: 50%;
      background: #eef1f4; color: #656d76; font-size: .72em; font-weight: 700;
      display: grid; place-items: center;
    }
    .rung.r3 .rung-n { background: #1f2328; color: #fff; }
    .rung-head div { flex: 1; min-width: 0; }
    .rung-head b { display: block; font-size: .88em; line-height: 1.2; }
    .rung-head i { display: block; font-style: normal; font-size: .68em; color: #8b949e; line-height: 1.25; margin-top: .1em; }
    .rung-count { font-size: .72em; font-weight: 700; color: #b0b8c0; }

    .rung-body { padding: .45em; display: flex; flex-direction: column; gap: .4em; min-height: 3em; }
    .rtoy {
      display: flex; align-items: center; gap: .5em;
      background: #fff; border: 1px solid #e8ecef; border-left: 3px solid var(--tint);
      border-radius: 7px; padding: .3em .4em; position: relative;
      transition: transform .15s ease, box-shadow .15s ease;
    }
    .rtoy:hover { transform: translateX(2px); box-shadow: 0 3px 10px rgba(0,0,0,.07); }
    .rtoy img { width: 34px; height: 34px; object-fit: cover; border-radius: 4px; flex-shrink: 0; background: #0b0d10; }
    .rtoy-noimg { width: 34px; height: 34px; border-radius: 4px; background: var(--tint); flex-shrink: 0; opacity: .6; }
    .rtoy-txt { min-width: 0; flex: 1; }
    .rtoy-txt b { display: block; font-size: .78em; line-height: 1.2; }
    .rtoy-txt i {
      display: block; font-style: normal; font-size: .66em; color: #8b949e;
      line-height: 1.25; margin-top: .1em;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .rtoy-shots { font-size: .62em; font-weight: 700; color: #b0b8c0; flex-shrink: 0; }

    .lad-desk { margin-top: 2.2em; padding: .9em 1em; background: #f6f8fa; border: 1px solid #eaecef; border-radius: 10px; }
    .ld-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: .6em; margin-bottom: .6em; }
    .ld-head b { font-size: .95em; }
    .ld-head span { font-size: .78em; color: #8b949e; }
    .ld-row { display: flex; flex-wrap: wrap; gap: .3em; align-items: center; margin-bottom: .3em; }
    .ld-label { font-size: .7em; font-weight: 700; background: var(--tint); border-radius: 4px; padding: .1em .45em; width: 3.6em; text-align: center; }
    .ld-item { font-size: .76em; color: #656d76; background: #fff; border: 1px solid #e6eaee; border-radius: 5px; padding: .08em .5em; }

    @media (max-width: 780px) {
      .ladder { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 460px) {
      .ladder { grid-template-columns: 1fr; }
    }
  </style>

  <hr />
  <PageFooter active="research" />
</DefaultLayout>
