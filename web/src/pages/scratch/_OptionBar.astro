---
import { OPTIONS } from './_data';
interface Props { active: string }
const { active } = Astro.props;
const cur = OPTIONS.find((o) => o.slug === active)!;
---
<div class="optbar">
  <a href="/scratch/" class="ob-home">Options</a>
  {OPTIONS.map((o) => (
    <a href={`/scratch/${o.slug}/`} class={o.slug === active ? 'ob on' : 'ob'}>
      <b>{o.n}</b> {o.name}
    </a>
  ))}
</div>
<p class="ob-thesis"><b>Option {cur.n} — {cur.name}.</b> {cur.thesis}</p>

<style is:global>
  .optbar {
    display: flex; flex-wrap: wrap; gap: .3em; align-items: center;
    margin: 0 0 .6em; padding: .5em .6em;
    background: #f6f8fa; border: 1px dashed #c3ccd5; border-radius: 8px;
    font-size: .82em;
  }
  .optbar .ob-home { font-weight: 700; color: #656d76; margin-right: .4em; }
  .optbar .ob {
    padding: .25em .6em; border-radius: 6px; color: #475059;
    background: #fff; border: 1px solid #d8dee4; text-decoration: none;
  }
  .optbar .ob b { color: #8b949e; }
  .optbar .ob:hover { border-color: #0969da; color: #0969da; text-decoration: none; }
  .optbar .ob.on { background: #1f2328; color: #fff; border-color: #1f2328; }
  .optbar .ob.on b { color: #8b949e; }
  .ob-thesis { font-size: .88em; color: #656d76; margin: 0 0 1.6em; }
  .ob-thesis b { color: #1f2328; }
</style>
