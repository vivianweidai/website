---
import DefaultLayout from '../../layouts/Default.astro';
import PageHeader from '../../layouts/PageHeader.astro';
import PageFooter from '../../layouts/PageFooter.astro';
import OptionBar from './_OptionBar.astro';
import { SESSIONS, STREAM, SCI, BENCH, DESK } from './_data';
---
<DefaultLayout title="Projects — The Logbook">
  <PageHeader active="research" title="Projects" />
  <OptionBar active="logbook" />

  <div class="log-top">
    <div class="log-filters">
      <button class="lf on" data-f="all">All</button>
      {(['phys','chem','bio','astro'] as const).map((s) => (
        <button class="lf" data-f={s} style={`--f: ${SCI[s].tint}`}>{SCI[s].abbr}</button>
      ))}
    </div>
    <a class="log-inv" href="#inventory">{BENCH.length} toys on the bench ↓</a>
  </div>

  <div class="log">
    {SESSIONS.map((s) => (
      <article class="entry" data-sci={s.sci} style={`--tint: ${SCI[s.sci].tint}`}>
        <div class="entry-rail">
          <span class="entry-date">{s.date}</span>
          <span class="entry-dot" />
        </div>
        <div class="entry-body">
          <h3>{s.title}</h3>
          <div class="entry-tags">
            <span class="etag sci">{SCI[s.sci].name}</span>
            <span class="etag">{s.toy}</span>
          </div>
          <p class="entry-note">{s.note}</p>
          <div class={`entry-shots n${s.shots.length}`}>
            {s.shots.map((i) => (
              <figure class={STREAM[i].tall ? 'tall' : ''}>
                <img src={STREAM[i].src} alt={STREAM[i].cap} loading="lazy" />
                <figcaption>{STREAM[i].cap}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </article>
    ))}
  </div>

  <h3 id="inventory" class="inv-head">What we have to play with</h3>
  <p class="inv-sub">
    The bench is {BENCH.length} instruments. The desk is {DESK.length} archives and libraries —
    listed, never photographed.
  </p>
  <div class="inv">
    {(['phys','chem','bio','astro'] as const).map((s) => (
      <div class="inv-row" style={`--tint: ${SCI[s].tint}`}>
        <div class="inv-label">{SCI[s].name}</div>
        <div class="inv-items">
          {BENCH.filter((t) => t.sci === s).map((t) => <span class="inv-item">{t.short}</span>)}
        </div>
      </div>
    ))}
    <div class="inv-row desk" style="--tint: #e2e6ea">
      <div class="inv-label">Desk</div>
      <div class="inv-items">
        {DESK.map((t) => <span class="inv-item">{t.short}</span>)}
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var bar = document.querySelector('.log-filters');
      bar.addEventListener('click', function (e) {
        var b = e.target.closest('.lf'); if (!b) return;
        var f = b.dataset.f;
        bar.querySelectorAll('.lf').forEach(function (x) { x.classList.toggle('on', x === b); });
        document.querySelectorAll('.entry').forEach(function (c) {
          c.style.display = (f === 'all' || c.dataset.sci === f) ? '' : 'none';
        });
      });
    })();
  </script>

  <style is:global>
    .log-top { display: flex; align-items: center; justify-content: space-between; gap: 1em; margin-bottom: 1.6em; }
    .log-filters { display: flex; gap: .3em; }
    .lf {
      font: inherit; font-size: .8em; font-weight: 600; cursor: pointer;
      padding: .22em .7em; border-radius: 999px;
      border: 1px solid #d8dee4; background: #fff; color: #475059;
    }
    .lf:hover { background: var(--f, #f6f8fa); }
    .lf.on { background: var(--f, #1f2328); border-color: transparent; color: #1f2328; }
    .lf[data-f="all"].on { background: #1f2328; color: #fff; }
    .log-inv { font-size: .82em; color: #656d76; }

    .log { border-left: 2px solid #eaecef; margin-left: 5.4em; }
    .entry { position: relative; padding: 0 0 2.6em 1.6em; }
    .entry-rail { position: absolute; left: 0; top: .15em; }
    .entry-date {
      position: absolute; right: 1.3em; top: 0; width: 6em; text-align: right;
      font-size: .78em; font-weight: 600; color: #8b949e; white-space: nowrap;
    }
    .entry-dot {
      position: absolute; left: -7px; top: .35em; width: 12px; height: 12px;
      border-radius: 50%; background: var(--tint); border: 2px solid #fff;
      box-shadow: 0 0 0 1px #dfe3e8;
    }
    .entry h3 { margin: 0; font-size: 1.05em; border: none; padding: 0; line-height: 1.35; }
    .entry-tags { display: flex; gap: .3em; margin: .4em 0 .5em; }
    .etag {
      font-size: .7em; font-weight: 600; padding: .1em .5em; border-radius: 4px;
      background: #f1f3f5; color: #475059;
    }
    .etag.sci { background: var(--tint); color: #1f2328; }
    .entry-note { margin: 0 0 .8em; font-size: .9em; color: #475059; max-width: 42em; }

    .entry-shots { display: grid; gap: 8px; }
    .entry-shots.n1 { grid-template-columns: minmax(0, 26em); }
    .entry-shots.n2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .entry-shots.n3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .entry-shots figure { margin: 0; }
    .entry-shots img {
      width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block;
      border-radius: 7px; background: #0b0d10;
    }
    /* Seestar shoots 9:16. A 4:3 crop throws away most of the frame, so
       portrait captures get a portrait tile. */
    .entry-shots figure.tall img { aspect-ratio: 3 / 4; }
    /* …but two portrait tiles at full width would eat a whole screen, so a
       row containing any of them is narrowed rather than made taller. */
    .entry-shots:has(figure.tall) { max-width: 27em; }
    .entry-shots figcaption { font-size: .72em; color: #8b949e; margin-top: .3em; line-height: 1.3; }

    .inv-head { margin-top: 1em; border-bottom: 1px solid #d1d9e0; padding-bottom: .3em; }
    .inv-sub { font-size: .85em; color: #8b949e; margin: .4em 0 1em; }
    .inv-row { display: flex; gap: .8em; align-items: baseline; margin: .5em 0; }
    .inv-label {
      flex: 0 0 6em; font-size: .78em; font-weight: 700;
      background: var(--tint); border-radius: 5px; padding: .1em .5em; text-align: center;
    }
    .inv-items { display: flex; flex-wrap: wrap; gap: .3em; }
    .inv-item { font-size: .8em; background: #f6f8fa; border-radius: 5px; padding: .1em .55em; color: #475059; }
    .inv-row.desk .inv-item { color: #8b949e; }

    @media (max-width: 700px) {
      .log { margin-left: 0; }
      .entry-date { position: static; display: block; width: auto; text-align: left; margin-bottom: .2em; }
      .entry-rail { position: static; }
      .entry-dot { display: none; }
      .entry { padding-left: .9em; }
      .entry-shots.n3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
  </style>

  <hr />
  <PageFooter active="research" />
</DefaultLayout>
