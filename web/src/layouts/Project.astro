---
import './base.css';
import './tabs.css';
import faviconSvg from './favicon.svg?url';
import PageHeader from './PageHeader.astro';
import PageFooter from './PageFooter.astro';

interface Props {
  project: string;
  title: string;
  sciences: string[];
  htmlLang?: string;
  photos?: string[];
}

const {
  project,
  title,
  sciences,
  htmlLang = 'en',
  photos = [],
} = Astro.props;

// Full → short slug for chip class names. Same map used by technology.json.
const SLUG: Record<string, string> = {
  Mathematics: 'mathematics', Computing: 'computing', Physics: 'physics',
  Chemistry: 'chemistry', Biology: 'biology', Astronomy: 'astronomy',
};

// Title-row pills: one science-coloured pill per science, linking to the wall
// filtered to it. These used to be per-tech pills pointing at tech pages;
// those pages were deleted 2026-07-30, so the science is what is left to say.
const titlePills = sciences.map((s) => ({ label: s, url: `/projects/#${SLUG[s]}`, slug: SLUG[s] }));
---
<!DOCTYPE html>
<html lang={htmlLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <link rel="icon" type="image/svg+xml" href={faviconSvg} />
  <title>{project || title || 'Vivian Dai'}</title>
  <script is:inline set:html={`window._pagePhotos = ${JSON.stringify(photos)};`} />
  <style is:global>
    /* Project layout specific styles */
    .photo-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.5em;
      margin: 1em 0 0.5em 0;
    }
    .photo-grid img {
      width: 100%;
      height: 200px;
      object-fit: cover;
      border-radius: 6px;
    }
    .photo-grid.three-col {
      grid-template-columns: 1fr 1fr 1fr;
    }
    .shuffle-btn {
      display: block;
      margin: 2em auto 1.5em auto;
      padding: 0.4em 1.2em;
      border: 1px solid #d1d9e0;
      border-radius: 6px;
      background: #f6f8fa;
      color: #1f2328;
      font-size: 0.85em;
      cursor: pointer;
      transition: background 0.15s, border-color 0.15s;
    }
    .shuffle-btn:hover {
      background: #ddf4ff;
      border-color: #0969da;
    }
    .hero-single img {
      width: 100%;
      height: 250px;
      object-fit: cover;
      border-radius: 6px;
      margin: 1em 0 0.5em 0;
    }
    .project-meta {
      text-align: right;
      font-size: 0.9em;
      color: #656d76;
      margin-bottom: 1.5em;
    }
    .chip {
      display: inline-block; padding: 1px 7px; border-radius: 999px;
      font-size: .72em; font-weight: 600; color: #1f2328;
      text-align: center; white-space: nowrap; line-height: 1.6;
    }
    .chip.mathematics  { background: var(--subj-mathematics); }
    .chip.computing  { background: var(--subj-computing); }
    .chip.physics  { background: var(--subj-physics); }
    .chip.chemistry  { background: var(--subj-chemistry); }
    .chip.biology   { background: var(--subj-biology); }
    .chip.astronomy { background: var(--subj-astronomy); }
    /* Project title sits below the Research header — tone it down */
    body > h1:first-of-type { font-size: 1.6em; margin-top: 0.8em; }
    .project-title {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1em;
      margin: 0.8em 0;
    }
    .project-title h1 {
      font-size: 1.6em;
      margin: 0;
      border-bottom: none;
    }
    .project-chips {
      display: inline-flex;
      gap: 0.5em;
      flex-wrap: wrap;
    }
    .section-heading {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 1em;
      border-bottom: 1px solid #d1d9e0;
      padding-bottom: 0.3em;
      margin-top: 1.5em;
    }
    .section-heading h2 {
      margin: 0;
      border-bottom: none;
      padding-bottom: 0;
    }
    .section-date {
      font-size: 0.9em;
      color: #656d76;
    }
    .setup-highlight tbody tr:first-child td { background: #fff44f; }
    .setup-highlight-all tbody tr td { background: #fff44f; }
    .instrument-table tbody tr td { background: #fff44f; }
    .instrument-table.no-highlight tbody tr td { background: transparent; }

    /* ── WALKTHROUGH FORMAT ──────────────────────────────────────────
       The step-by-step data-to-analysis report. One numbered step per
       thing that happened, a `term` pull-out wherever a word needs
       defining, and a figure under whichever step it belongs to.
       Legacy reports use the shuffle grid + instrument tables above;
       these classes are what replaced them. See PROJECTS.md. */

    .lede {
      font-size: 1.08em;
      color: #3d444d;
      margin: 0.2em 0 1.4em;
      padding-bottom: 1.2em;
      border-bottom: 1px solid #d1d9e0;
    }

    .step { margin: 2.2em 0; }
    .step > h3 {
      display: flex;
      gap: 0.7em;
      align-items: baseline;
      font-size: 1.15em;
      margin: 0 0 0.6em;
      border-bottom: none;
      padding-bottom: 0;
    }
    .step > h3::before {
      counter-increment: step;
      content: counter(step);
      flex: none;
      width: 1.6em;
      height: 1.6em;
      border-radius: 50%;
      background: #b3576b;
      color: #fff;
      font-size: 0.68em;
      font-weight: 700;
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transform: translateY(-0.15em);
    }
    /* Reset on body, so numbering runs unbroken across the whole page and
       an `## ` section head can group steps without restarting the count. */
    body { counter-reset: step; }
    .step > *:not(h3):not(.tall):not(.small):not(.medium) { margin-left: 3em; }
    .step .term, .step .result, .step .eq { margin-left: 3em; }

    /* Pull-out: a key technical term, defined where it first bites. */
    .term {
      border-left: 3px solid #b3576b;
      background: #fbf7f8;
      padding: 0.8em 1em;
      margin: 1em 0;
      border-radius: 0 5px 5px 0;
      font-size: 0.95em;
      color: #3d444d;
    }
    .term > *:first-child { margin-top: 0; }
    .term > *:last-child { margin-bottom: 0; }
    /* Markdown `**term**` inside a pull-out — the word being defined. */
    .term strong { color: #1f2328; font-weight: 700; }

    /* The answer, or any number the step exists to produce. */
    .result {
      background: #f6f8fa;
      border: 1px solid #d1d9e0;
      border-left: 4px solid #b3576b;
      padding: 0.9em 1.1em;
      margin: 1.2em 0;
      border-radius: 0 5px 5px 0;
    }
    .result > *:first-child { margin-top: 0; }
    .result > *:last-child { margin-bottom: 0; }
    .result .big { font-size: 1.2em; font-weight: 600; }

    /* MathJax SVG inside an equation box. Glyphs are paths, so they take their
       colour from currentColor and need no font file to sit correctly.
       MathJax writes its own font-size onto the container, hence !important. */
    .eq mjx-container { margin: 0 !important; font-size: 1.75em !important; }
    .eq mjx-container svg { max-width: 100%; height: auto; }
    .eq:has(mjx-container) { font-family: inherit; padding: 1.2em 1em; }

    .eq {
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 0.92em;
      text-align: center;
      background: #f6f8fa;
      border: 1px solid #d1d9e0;
      border-radius: 5px;
      padding: 0.8em 1em;
      margin: 1em 0;
      overflow-x: auto;
      position: relative;
    }
    /* A numbered equation lays out as a grid: the numeral in its own column at
       the far left, the maths centred in the rest. Grid rather than absolute
       positioning so the number can never overlap a long equation. The number
       is the only thing in the box — an equation is explained in the prose
       above it, never in a caption inside it. */
    .eq:has(.eq-n) {
      display: grid;
      grid-template-columns: 2.4em 1fr;
      align-items: center;
      text-align: center;
    }
    .eq .eq-n {
      font-family: -apple-system, BlinkMacSystemFont, sans-serif;
      font-size: 1.6em;
      font-weight: 600;
      color: #c9d1d9;
      line-height: 1;
      text-align: left;
    }
    .eq small {
      display: block;
      font-size: 0.78em;
      color: #656d76;
      margin-top: 0.4em;
      font-family: -apple-system, BlinkMacSystemFont, sans-serif;
    }

    figure { margin: 1.2em 0; }
    figure img { width: 100%; display: block; border-radius: 6px; }
    figcaption {
      font-size: 0.85em;
      color: #656d76;
      margin-top: 0.5em;
      line-height: 1.5;
    }
    .row { display: grid; gap: 0.6em; grid-template-columns: repeat(3, 1fr); }
    .row.two { grid-template-columns: repeat(2, 1fr); }
    .row figure { margin: 0; }
    .row figcaption { text-align: center; }
    /* A single photo making a single point does not need the full column.
       Both are centred — a narrow figure flush left reads as a mistake. */
    .tall  { max-width: 17em; margin-left: auto; margin-right: auto; }
    .small { max-width: 26em; margin-left: auto; margin-right: auto; }
    /* Between .small and full width. For a diagram whose own labels stop being
       legible if the whole thing is scaled down to photograph size. */
    .medium { max-width: 36em; margin-left: auto; margin-right: auto; }
    /* Centred figures are excluded from the step indent above, so their auto
       margins are free to centre them across the full column. */

    @media (max-width: 640px) {
      .step > *:not(h3):not(.tall):not(.small):not(.medium) { margin-left: 0; }
      .step .term, .step .result, .step .eq { margin-left: 0; }
      .row { grid-template-columns: 1fr 1fr; }
    }
  </style>
</head>
<body>
  <PageHeader title="Projects" />

  <div class="project-title">
    <h1>
      {title}
    </h1>
    <span class="project-chips">
      {titlePills.map((p, i) => (
        <>
          {i > 0 && ' '}
          <a class={`chip ${p.slug}`} href={p.url}>{p.label}</a>
        </>
      ))}
    </span>
  </div>

  <slot />

  <hr />

  <PageFooter />

  <script is:inline>
    // Top photo grid: shuffle on load and expose the function for the Shuffle button.
    window.shufflePhotos = function() {
      var photos = (window._pagePhotos || []).slice();
      for (var i = photos.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var t = photos[i]; photos[i] = photos[j]; photos[j] = t;
      }
      for (var i = 0; i < 4; i++) {
        var el = document.getElementById('photo-' + i);
        if (el && photos[i]) el.src = photos[i];
      }
    };
    if (document.getElementById('photo-0')) window.shufflePhotos();
    // Tab containers: pick a random initial tab so viewers cycle through all of them.
    document.querySelectorAll('.tabs').forEach(function(container) {
      var radios = container.querySelectorAll('input[type="radio"]');
      if (radios.length === 0) return;
      radios[Math.floor(Math.random() * radios.length)].checked = true;
    });
  </script>
</body>
</html>
