---
import { getCollection, render } from 'astro:content';
import { readdirSync, statSync, existsSync } from 'node:fs';
import { join, relative } from 'node:path';
import ProjectLayout from '../../../../layouts/Project.astro';
import techData from '../../../../../public/research/technology.json';

// tech name → candidate {url, science, slug}. A name can exist in more than
// one science (Chemistry and Astronomy both have "Spectroscopy"), so each
// project disambiguates by its own sciences below.
const TECH_INDEX: Record<string, { url: string; science: string; slug: string }[]> = {};
for (const s of techData.sciences) {
  for (const tech of s.techs) {
    (TECH_INDEX[tech.tech] ??= []).push({
      url: tech.tech_url, science: s.science, slug: s.science_slug,
    });
  }
}

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  return projects.map((entry) => {
    // generateId in content.config.ts preserves the original folder name as id.
    const folder = entry.id;

    // Discover photos under public/research/projects/<folder>/photos/, excluding photos/data/.
    // Photos serve at /research/projects/<folder>/photos/... (Astro public/ → URL root).
    const photosRoot = join(process.cwd(), 'public', 'research', 'projects', folder, 'photos');
    const photos: string[] = [];
    if (existsSync(photosRoot)) {
      const walk = (dir: string) => {
        for (const name of readdirSync(dir)) {
          const full = join(dir, name);
          const st = statSync(full);
          if (st.isDirectory()) {
            // Skip photos/data/ — data sheets are surfaced separately, not in shuffle.
            if (relative(photosRoot, full) === 'data') continue;
            walk(full);
          } else if (/\.(jpg|jpeg|png)$/i.test(name)) {
            // Absolute URL since file path (under public/) differs from page URL (/research/projects/<folder>/).
            photos.push(`/research/projects/${folder}/photos/` + relative(photosRoot, full));
          }
        }
      };
      walk(photosRoot);
    }

    return {
      params: { slug: folder },
      props: { entry, photos },
    };
  });
}

const { entry, photos } = Astro.props;
const { Content } = await render(entry);

// Title-row pills: one per tech the project used, science-colored, linking to
// the tech page. Replaces the old hand-coded Technology table at the page foot.
const projSciences = entry.data.sciences ?? [];
const techPills = (entry.data.tech ?? [])
  .map((name) => {
    const cands = TECH_INDEX[name] ?? [];
    const pick = cands.find((c) => projSciences.includes(c.science)) ?? cands[0];
    return pick ? { label: name, url: pick.url, slug: pick.slug } : null;
  })
  .filter((p): p is { label: string; url: string; slug: string } => p !== null);
---
<ProjectLayout
  project={entry.data.project}
  title={entry.data.title}
  sciences={entry.data.sciences}
  techPills={techPills}
  mi={entry.data.mi}
  photos={photos}
>
  <Content />
</ProjectLayout>
