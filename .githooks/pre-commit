#!/bin/sh
# Pre-commit BLOAT WARNING — does not block, just flags oversized files.
# Activated by running once: git config core.hooksPath .githooks

PDF_LIMIT=5242880     # 5 MB

staged=$(git diff --cached --name-only --diff-filter=AM)
[ -z "$staged" ] && exit 0

pdf_warns=""

while IFS= read -r f; do
  [ -z "$f" ] || [ ! -f "$f" ] && continue
  size=$(wc -c < "$f" 2>/dev/null | tr -d ' ')
  [ -z "$size" ] && continue

  case "$(printf '%s' "$f" | tr '[:upper:]' '[:lower:]')" in
    *.pdf)
      if [ "$size" -gt "$PDF_LIMIT" ]; then
        pdf_warns="${pdf_warns}  $(du -h "$f" | cut -f1)\t$f\n"
      fi
      ;;
  esac
done <<EOF
$staged
EOF

# Stale-generated-file warning. The JSON manifests are built from YAML/markdown
# sources by pipeline/scripts/build_*.py and consumed by the Astro homepage AND
# the Apple app. Editing a source without regenerating its JSON silently ships
# stale data to the app — this is exactly how technology.json drifted to point
# at deleted .png heroes. Warn when a source is staged but its generated JSON is not.
staged_all=$(git diff --cached --name-only)
gen_warns=""

# technology.json ← technology.yml + every tech page's index.md frontmatter (hero)
if printf '%s\n' "$staged_all" | grep -Eq '^web/public/research/technology\.yml$|^web/public/research/technology/.+/index\.md$'; then
  printf '%s\n' "$staged_all" | grep -q '^web/public/research/technology\.json$' \
    || gen_warns="${gen_warns}  technology.json not staged — run: python pipeline/scripts/build_technology.py\n"
fi

# olympiads.json ← olympiads.yml
if printf '%s\n' "$staged_all" | grep -q '^web/public/olympiads/olympiads\.yml$'; then
  printf '%s\n' "$staged_all" | grep -q '^web/public/olympiads/olympiads\.json$' \
    || gen_warns="${gen_warns}  olympiads.json not staged — run: python pipeline/scripts/build_olympiads.py\n"
fi

if [ -n "$gen_warns" ]; then
  printf '\n\033[33m⚠️  stale generated file — a source is staged but its JSON manifest is not:\033[0m\n' >&2
  printf '%b' "$gen_warns" >&2
  printf 'The Astro homepage and the iOS app read the JSON, not the source.\nRebuild and stage the JSON, or use --no-verify if intentional.\n\n' >&2
fi

if [ -n "$pdf_warns" ]; then
  printf '\n\033[33m⚠️  bloat warning — staged PDFs exceed the 5 MB soft limit (commit will proceed):\033[0m\n' >&2
  printf '\nConsider: gs -sDEVICE=pdfwrite -dPDFSETTINGS=/ebook -dNOPAUSE -dQUIET -dBATCH -sOutputFile=out.pdf in.pdf\n' >&2
  printf '%b' "$pdf_warns" >&2
  printf '\nHandle case-by-case. Use --no-verify if intentional.\n\n' >&2
fi

exit 0
