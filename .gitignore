# macOS
.DS_Store
.AppleDouble
.LSOverride

# Claude Code
.claude/
# (research scratch used to live here under work/ and was intentionally tracked;
#  work/ moved 2026-08-01 to the private working repo — called `sandbox` that
#  morning, renamed `science` that afternoon — nothing to except now)

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/

# Environment files
.env
.env.local

# Apple / Xcode (Science.xcodeproj is xcodegen-generated from apple/project.yml)
apple/.build/
apple/.swiftpm/
apple/Science.xcodeproj/
# App Store Connect account identifiers — private, never committed (public repo)
apple/.release.env

# Astro / Node / Wrangler
node_modules/
dist/
.astro/
.wrangler/

# Seestar interop — keep large app binaries + any stray keys out of git
# (the interop key lives at ~/.config/seestar/, outside the repo)
*.apk
*.xapk
*.pem
*.key

# Project folders are publication only — report.md and pictures. Raw frames,
# scripts and notebooks live in the science repo and are never copied here.
# These patterns are a guard against that happening by accident: web/public/ is
# served verbatim, so anything tracked here is also uploaded to Cloudflare and
# published, and a 16 MB FITS committed once cannot really be taken back.
web/public/projects/*/data/
web/public/projects/*/output/
